# Copy to .env.test for `pnpm test:e2e`. test/setup-e2e.ts refuses to run unless:
#   - DATABASE_URL points at a database whose name ends in "_test"
#   - REDIS_URI (and REDIS_MATCH_URI if set) select a non-zero Redis DB
#   - QUEUE_PREFIX starts with "bull_test"
# Every key below is set (even when empty) so nothing is filled from .env:
# integrations stay disabled and no real mail/AI/payment call can happen.

NODE_ENV=test
APP_NAME="PokeNihongo Test"
APP_URL=
APP_PORT=0
API_PREFIX=
APP_CORS_ORIGIN=http://localhost

DATABASE_URL="postgresql://postgres:1234554321@localhost:5432/pokenihongo_test?schema=public"

REDIS_URI=redis://localhost:6379/15
REDIS_MATCH_URI=
QUEUE_PREFIX=bull_test

ACCESS_TOKEN_SECRET=test-access-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=test-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d
ACCESS_TOKEN_GUEST_EXPIRES_IN=15m
REFRESH_TOKEN_GUEST_EXPIRES_IN=7d
SECRET_API_KEY=test-api-key
OTP_EXPIRES_IN=5m

ADMIN_NAME=admin
ADMIN_PASSWORD=test-admin-password
ADMIN_EMAIL=admin@example.test
PHONE_NUMBER=0000000000

# Integrations: fake or empty on purpose
PAYOS_CLIENT_ID=test
PAYOS_API_KEY=test
PAYOS_CHECKSUM_KEY=test
GEMINI_API_KEY=
GEMINI_FLASH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_REDIRECT_URI=
# VertexAIService refuses to boot without these (env.config marks them optional).
# Fake values: the Google client only authenticates when an AI call is made, and
# tests must never call AI endpoints.
GOOGLE_CLOUD_PROJECT_ID=test-project
GOOGLE_CLOUD_CLIENT_EMAIL=test@test-project.iam.gserviceaccount.com
GOOGLE_CLOUD_PRIVATE_KEY=fake-key-for-tests
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=
MAIL_AUTH=
MAIL_STARTTLS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FE_URL=http://localhost
MO_URL=
